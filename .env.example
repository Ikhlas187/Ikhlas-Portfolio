# Variables du site en ligne : à poser dans Vercel (Settings > Environment Variables), pas dans un fichier.
# Rien n'est nécessaire pour `pnpm dev` : sans elles, les notes épinglées restent dans le navigateur.

# Chaîne de connexion Neon, lue par la fonction api/notes.ts : Dashboard Neon > Connect > « Connection string ».
DATABASE_URL="postgresql://<user>:<password>@<host>/<database>?sslmode=require"

# true : les notes épinglées sont partagées entre tous les visiteurs (api/notes.ts) au lieu de rester dans le navigateur.
VITE_SHARED_NOTES=true

# Facultatif : sel du hachage des adresses IP de l'anti-spam des notes.
NOTES_SALT="<texte-aleatoire>"
